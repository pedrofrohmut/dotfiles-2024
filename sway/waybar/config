{
  "modules-left": [
    // "hyprland/workspaces",
    "sway/workspaces"
    // "sway/mode",
    // "sway/scratchpad",
    // "custom/media"
  ],
  "modules-center": [
    // "hyprland/windowcount",
    // "hyprland/window",
    "sway/window",
  ],
  "modules-right": [
    "pulseaudio",
    "cpu",
    "memory",
    "clock#date",
    "clock#time",
    "tray"
  ],
  "pulseaudio": {
    "scroll-step": 5,
    "format": "vol: {volume}%",
    "format-muted": "vol: MUTED",
    "on-click": "pamixer --toggle-mute",
    "on-click-right": "pavucontrol",
    "tooltip": false
  },
  "cpu": {
    "format": "cpu: {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "ram: {}%",
    "tooltip": false
  },
  "clock#date": {
    "format": "{:%a %d-%m-%Y}",
    "tooltip": false
  },
  "clock#time": {
    "format": "{:%H:%M}",
    "tooltip": false
  },
  "tray": {
    "icon-size": 18,
    "spacing": 6,
    "tooltip": false
  }
}
